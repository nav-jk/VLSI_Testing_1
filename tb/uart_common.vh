// =============================================================================
// Common testbench utilities, included by every per-functionality testbench.
// Assumes the including module has declared (matching DUT port names):
//   reg  clk, rst, load, parity_en, parity_odd, tx_data[7:0];
//   reg  [15:0] baud_div;
//   wire tx, busy, done, ready;
// Clock convention: free-running clk, period CLK_PERIOD, generated by TB.
// Stimulus is driven on negedge clk; sampling of DUT outputs is also done
// at negedge (after the intervening posedge has let the DUT's NBAs settle),
// which avoids race conditions between TB and DUT.
// =============================================================================

integer pass_count = 0;
integer fail_count = 0;

task check;
    input         condition;
    input [8*80-1:0] msg;
    begin
        if (condition) begin
            pass_count = pass_count + 1;
            $display("  PASS: %0s", msg);
        end else begin
            fail_count = fail_count + 1;
            $display("  FAIL: %0s", msg);
        end
    end
endtask

task report;
    begin
        $display("----------------------------------------------------");
        $display("TOTAL PASS = %0d   TOTAL FAIL = %0d", pass_count, fail_count);
        if (fail_count == 0)
            $display("RESULT: PASS");
        else
            $display("RESULT: FAIL");
        $display("----------------------------------------------------");
    end
endtask

task do_reset;
    begin
        rst        = 1'b1;
        load       = 1'b0;
        tx_data    = 8'd0;
        parity_en  = 1'b0;
        parity_odd = 1'b0;
        baud_div   = 16'd16;
        @(negedge clk);
        @(negedge clk);
        rst = 1'b0;
        @(negedge clk);
    end
endtask

// Compute expected parity bit the same way the DUT does
function automatic parity_calc;
    input [7:0] data;
    input       odd;
    begin
        parity_calc = odd ? ~(^data) : (^data);
    end
endfunction

// Wait for `n` bit periods (each `div` clk cycles), sampled at negedge.
task automatic wait_bits;
    input [15:0] div;
    input integer n;
    integer i, j;
    begin
        for (j = 0; j < n; j = j + 1)
            for (i = 0; i < div; i = i + 1)
                @(negedge clk);
    end
endtask

// Load a byte (pulses `load` for one clock) without waiting for completion.
task automatic load_byte;
    input [7:0]  data;
    input        pen;
    input        podd;
    input [15:0] div;
    begin
        baud_div   = div;
        parity_en  = pen;
        parity_odd = podd;
        tx_data    = data;
        @(negedge clk);
        load = 1'b1;
        @(negedge clk);
        load = 1'b0;
    end
endtask

// Full directed frame check: loads a byte and checks start/data/parity/stop
// bits plus busy/done/ready timing. `div` should be small (e.g. 4-8) to keep
// simulation fast.
task automatic send_and_check_frame;
    input [7:0]  data;
    input        pen;
    input        podd;
    input [15:0] div;
    integer i;
    reg exp_par;
    reg [15:0] eff_div; // clamped copy used for timing (DUT clamps baud_div<2 to 2 internally)
    begin
        eff_div = (div < 16'd2) ? 16'd2 : div;
        load_byte(data, pen, podd, div);

        // One negedge after the load-clearing negedge: the intervening
        // posedge has already latched load and driven the START bit.
        check(tx === 1'b0, "START bit = 0");
        check(busy === 1'b1, "BUSY asserted at start of frame");

        wait_bits(eff_div, 1); // consume remainder of start-bit period -> now at edge of bit0

        for (i = 0; i < 8; i = i + 1) begin
            check(tx === data[i], "DATA bit correct (LSB-first order)");
            wait_bits(eff_div, 1);
        end

        if (pen) begin
            exp_par = parity_calc(data, podd);
            check(tx === exp_par, "PARITY bit correct");
            wait_bits(eff_div, 1);
        end

        check(tx === 1'b1, "STOP bit = 1");
        wait_bits(eff_div, 1);
        @(negedge clk); // one extra cycle: FSM's DONE state deasserts busy the cycle after STOP ends

        check(busy === 1'b0, "BUSY deasserted after frame");
        check(ready === 1'b1, "READY asserted after frame");
    end
endtask
